/Manifest.toml
.vscode/settings.json
.DS_Store
docs/build/
docs/node_modules/
docs/package-lock.json
# Generated by DocumenterVitepress; left untracked so DV keeps managing npm deps
docs/package.json
docs/src/.vitepress/dist/
docs/src/.vitepress/cache/

# Development artifacts
*.html
*.png
*.jls
junk*

# ...but the docs site's own images are content, not artifacts, and must be tracked
# or the deployed site loses its logo and figures.
!docs/src/assets/*.png

# Benchmark/profiling scripts (local only)
examples/benchmark_*.jl
examples/compare_outputs.jl
examples/quick_benchmark.jl
examples/time_test.jl
examples/*.txt
bench/*.txt
# ...except the numerical baseline, which is only useful if it is shared.
!bench/opt_bench_snapshot.txt

# Reports (generated during development)
CROSS_VALIDATION_SUMMARY.md
MATLAB_JULIA_COMPARISON.md
OPTIMIZATION_REPORT.md
OPTIMIZATION_RESULTS.txt
OPTIMIZATION_SUMMARY.md
PERFORMANCE_COMPARISON.md

# Test files not in runtests.jl
test/test_optimization_validation.jl
.claude/settings.local.json
test/Manifest.toml
bench/Manifest.toml

# Ground-truth cache for bench/calibrate_initial_guess.jl. A machine-local, regenerable
# artifact (`... truth`, ~14 min on 8 threads) whose contents are Julia-version-specific
# Serialization output, not a reviewable input.
bench/calibrate_initial_guess_truth.jls
